# StylusTx Relayer Configuration
# Copy to .env and fill in values

# Required: Paymaster contract address
PAYMASTER_ADDRESS=0x_paymaster_address_here

# Required: Relayer wallet private key (TESTNET ONLY!)
# This wallet pays gas for meta-transactions
RELAYER_PRIVATE_KEY=0x_relayer_private_key_here

# Optional: RPC URL (defaults to Arbitrum Sepolia)
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Optional: Chain ID (defaults to 421614 for Arbitrum Sepolia)
CHAIN_ID=421614

# Optional: Server port (defaults to 3001)
PORT=3001

# Optional: Log level (defaults to info)
LOG_LEVEL=info

# Optional: Node environment
NODE_ENV=development
